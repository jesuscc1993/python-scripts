#!/usr/bin/env bash

# collect staged .py files, NUL-separated to handle spaces in filenames
mapfile -d '' -t files < <(
  git diff --cached --name-only --diff-filter=ACM -z -- '*.py'
)

# if no .py files are staged, exit
[ ${#files[@]} -eq 0 ] && exit 0

# run lint and formatter on staged .py files only, then re-stage them
ruff check --fix "${files[@]}" || exit $?
ruff format "${files[@]}" || exit $?
git add -- "${files[@]}"

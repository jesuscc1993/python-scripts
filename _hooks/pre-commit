#!/bin/sh

# collect staged .py files, NUL-separated to handle spaces in filenames
files=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.py')

# if no .py files are staged, exit
[ -z "$files" ] && exit 0

# run lint and formatter on staged .py files only, then re-stage them
printf '%s' "$files" | xargs -0 ruff check --fix
printf '%s' "$files" | xargs -0 ruff format
printf '%s' "$files" | xargs -0 git add --

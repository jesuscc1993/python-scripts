{
  "icons_path": "Z:\\Images\\Icons\\Packs\\File Types\\ICO",
  "mappings": [
    {
      "exe_path": "Z:\\Software\\Development\\Notepad++\\notepad++.exe",
      "extensions": [
        "cfg",
        "conf",
        "css",
        "csv",
        "git",
        "gitignore",
        "inf",
        "ini",
        "js",
        "jsx",
        "json",
        "less",
        "log",
        "lua",
        "md",
        "nfo",
        "sass",
        "scss",
        "settings",
        "srt",
        "ts",
        "tsx",
        "txt",
        "vdf",
        "xml",
        "yaml",
        "yml"
      ],
      "type_name": "Text File",
      "fallback_icon": "_plain_text"
    },
    {
      "extensions": ["ahk", "bat", "html", "ps1", "py", "rb", "sh"],
      "type_name": "Text File",
      "fallback_icon": "_plain_text"
    },
    {
      "exe_path": "Z:\\Software\\Heavy\\Multimedia\\AIMP\\AIMP.exe",
      "extensions": ["aac", "flac", "mp3", "ogg", "wav"],
      "type_name": "Audio File"
    }
  ]
}
